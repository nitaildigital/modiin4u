# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Games (Unity projects — managed separately)
#
# Anchored to the repository root. Without the leading slash this also
# matched `lib/features/games/`, so the app's own Games screens were
# silently untracked — `web_games_screen.dart` was written and would never
# have been committed.
/games/

# Package lock (npm)
package-lock.json

# Client deliverables (not source)
*.docx

# Server-side secrets — never committed
.env.local

# Playwright MCP scratch output
.playwright-mcp/
