<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Network access (Supabase, Google Fonts, map tiles, images) -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Both are optional: the map works without them, and "near you" and
         distance are what ask for them. Coarse is enough for a city guide,
         and Android lets someone grant only that. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- The step counter. Optional: the screen says plainly when it is
         refused, rather than showing a number it does not have. Only needed
         from Android 10; older versions count steps without asking. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION"/>
    <uses-feature android:name="android.hardware.sensor.stepcounter"
                  android:required="false"/>

    <!-- Health Connect: the day's steps, distance and active calories as the
         phone and any watch or fitness app recorded them, for today and the
         last month. Read only; the app writes nothing to it. Google Play
         asks for a declaration of these in the Console before release. -->
    <uses-permission android:name="android.permission.health.READ_STEPS"/>
    <uses-permission android:name="android.permission.health.READ_DISTANCE"/>
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED"/>

    <!-- No camera or photo-library permission: every photo is chosen from
         the gallery, which image_picker opens through the system's photo
         picker (Android 13+) or the document chooser (before), neither of
         which needs one. Play rejects READ_MEDIA_IMAGES without a core use
         of the whole library (9 Oct). -->

    <!-- Push notifications. From Android 13 the app asks for this once;
         before it, notifications were allowed by default. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:label="Modiin4U"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- A push that arrives while the app is closed is drawn by Firebase,
             which reads these: the status-bar silhouette, its tint, and the
             channel MainActivity creates. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notification"/>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_tint"/>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="general"/>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Where the links in Supabase's emails land.
                 Confirming an address and resetting a password both send a
                 link; without this it opens a browser, which has no session
                 and cannot finish either. A custom scheme rather than an
                 https one, because an https link needs a verified domain and
                 the site is not deployed yet. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="il.co.modiin4u" android:host="auth"/>
            </intent-filter>

            <!-- Step group invitations: https://<site>/join/<code> opens the
                 app straight on the join screen once Android has verified the
                 site's /.well-known/assetlinks.json (served from
                 web/.well-known). Two sites: the interim secure address the
                 links use until app.modiin4u.co.il is live, and the domain.
                 Where the app is not verified, the website's join page offers
                 the scheme link below. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"/>
                <data android:host="app.modiin4u.co.il"/>
                <data android:host="45-93-94-49.sslip.io"/>
                <data android:pathPrefix="/join/"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="il.co.modiin4u"
                      android:host="app"
                      android:pathPrefix="/join/"/>
            </intent-filter>

            <!-- Urban Profile links: https://www.modiin4u.co.il/u/<username>.
                 Not auto-verified yet: www is the WordPress site until it
                 moves to our server, and on older Android one host that
                 fails verification would stop the /join/ links above from
                 opening the app too. Until then Android asks which app
                 opens it, or the website's /u/ page does. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"/>
                <data android:host="www.modiin4u.co.il"/>
                <data android:pathPrefix="/u/"/>
            </intent-filter>

            <!-- Health Connect's "why does this app ask" link. -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE"/>
            </intent-filter>
        </activity>
        <!-- Android 14's Health Connect settings link to how the app uses
             the data. Google requires the link; it opens the app, whose
             Step Counter says what is read and why. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE"/>
                <category android:name="android.intent.category.HEALTH_PERMISSIONS"/>
            </intent-filter>
        </activity-alias>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="true" />
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Filled from local.properties at build time, so the key is not in
             git. See android/app/build.gradle.kts. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- Whether Waze and Google Maps' navigation can be opened, for the
             car park page's directions (Android 11+ must name them). -->
        <package android:name="com.waze"/>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="waze"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="google.navigation"/>
        </intent>
        <!-- Whether Health Connect is installed (Android 13 and older). -->
        <package android:name="com.google.android.apps.healthdata"/>
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
